<UserControl x:Class="FlexiTrack.Desktop.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FlexiTrack.Desktop.ViewModels">
    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Task Logs"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="8,4"
                        FontSize="11" />
            </Grid>

            <!-- Date Filter Buttons -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                <RadioButton Content="Today"
                             IsChecked="{Binding SelectedDateFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=today}"
                             Command="{Binding SetDateFilterCommand}"
                             CommandParameter="today"
                             Style="{StaticResource FilterButtonStyle}"
                             Margin="0,0,4,4" />
                <RadioButton Content="This Week"
                             IsChecked="{Binding SelectedDateFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=week}"
                             Command="{Binding SetDateFilterCommand}"
                             CommandParameter="week"
                             Style="{StaticResource FilterButtonStyle}"
                             Margin="0,0,4,4" />
                <RadioButton Content="Last Week"
                             IsChecked="{Binding SelectedDateFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=lastweek}"
                             Command="{Binding SetDateFilterCommand}"
                             CommandParameter="lastweek"
                             Style="{StaticResource FilterButtonStyle}"
                             Margin="0,0,4,4" />
                <RadioButton Content="This Month"
                             IsChecked="{Binding SelectedDateFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=month}"
                             Command="{Binding SetDateFilterCommand}"
                             CommandParameter="month"
                             Style="{StaticResource FilterButtonStyle}"
                             Margin="0,0,4,4" />
                <RadioButton Content="Last Month"
                             IsChecked="{Binding SelectedDateFilter, Converter={StaticResource StringMatchConverter}, ConverterParameter=lastmonth}"
                             Command="{Binding SetDateFilterCommand}"
                             CommandParameter="lastmonth"
                             Style="{StaticResource FilterButtonStyle}"
                             Margin="0,0,4,4" />
            </WrapPanel>

            <!-- Client Filter -->
            <ComboBox Grid.Row="2"
                      x:Name="ClientFilterCombo"
                      Margin="0,0,0,12"
                      Padding="8,6"
                      SelectionChanged="ClientFilterCombo_SelectionChanged" />

            <!-- Stats -->
            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Filtered"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding TotalHoursDisplay}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="This Week"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding WeekTotalDisplay}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Progress Bar (if weekly target is set) -->
            <Grid Grid.Row="4" Margin="0,0,0,12"
                  Visibility="{Binding WeeklyTarget, Converter={StaticResource NullToVisibilityConverter}}">
                <ProgressBar Height="8"
                             Value="{Binding ProgressPercentage}"
                             Maximum="100"
                             Background="{StaticResource BackgroundBrush}"
                             Foreground="{StaticResource SuccessBrush}" />
            </Grid>

            <!-- Task List -->
            <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,6"
                                    x:Name="TaskRow">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Task Info -->
                                    <StackPanel Grid.Column="0">
                                        <!-- Date & Time -->
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding Date, StringFormat='{}{0:ddd dd MMM}'}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}" />
                                            <Run Text="-" />
                                            <Run Text="{Binding EndTime, StringFormat='{}{0:HH:mm}'}" />
                                        </TextBlock>

                                        <!-- Description -->
                                        <TextBlock Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12"
                                                   Margin="0,2,0,0" />

                                        <!-- Client -->
                                        <TextBlock Text="{Binding Client}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{Binding Client, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="Edit"
                                                Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="6,3"
                                                FontSize="10"
                                                Margin="0,0,4,0" />
                                        <Button Content="Del"
                                                Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="6,3"
                                                FontSize="10"
                                                Foreground="White"
                                                Background="{StaticResource DangerBrush}"
                                                BorderThickness="0"
                                                Cursor="Hand" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty State -->
            <TextBlock Grid.Row="5"
                       Text="No entries found"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding FilteredTasks.Count, Converter={StaticResource ZeroToVisibilityConverter}, FallbackValue=Collapsed}" />
        </Grid>
    </Border>
</UserControl>
