<UserControl x:Class="FlexiTrack.Desktop.Views.QuickLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FlexiTrack.Desktop.ViewModels">
    <StackPanel>
        <!-- Quick Log Form -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Text="Quick Log"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,12" />

                <!-- Date -->
                <DatePicker Grid.Row="1"
                            SelectedDate="{Binding Date}"
                            Margin="0,0,0,8" />

                <!-- Time Range -->
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Start time (HH:mm)" />

                    <TextBlock Grid.Column="1"
                               Text=" - "
                               VerticalAlignment="Center"
                               Margin="8,0" />

                    <TextBox Grid.Column="2"
                             Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="End time (HH:mm)" />

                    <TextBlock Grid.Column="3"
                               Text="{Binding Duration}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>

                <!-- Description -->
                <TextBox Grid.Row="3"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="60"
                         Margin="0,0,0,8"
                         VerticalContentAlignment="Top"
                         ToolTip="What did you work on?" />

                <!-- Client -->
                <ComboBox Grid.Row="4"
                          Text="{Binding Client, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Clients}"
                          IsEditable="True"
                          Margin="0,0,0,8"
                          ToolTip="Client (optional)" />

                <!-- Error Message -->
                <TextBlock Grid.Row="5"
                           Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                <!-- Save Button -->
                <Button Grid.Row="6"
                        Content="Save Entry"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" />
            </Grid>
        </Border>

        <!-- Entries for Date -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header with Filter and Total -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Entries"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <ComboBox x:Name="ListClientFilterCombo"
                              Grid.Column="1"
                              Margin="12,0"
                              ToolTip="Filter by client">
                        <ComboBoxItem Content="All Clients" Tag="all" IsSelected="True" />
                    </ComboBox>

                    <TextBlock Grid.Column="2"
                               Text="{Binding TotalDuration}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Task List -->
                <ItemsControl Grid.Row="2"
                              ItemsSource="{Binding TasksForDate}"
                              MaxHeight="200">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Time -->
                                    <TextBlock Grid.Column="0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Top"
                                               Margin="0,0,8,0">
                                        <Run Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}" />
                                        <Run Text="-" />
                                        <Run Text="{Binding EndTime, StringFormat='{}{0:HH:mm}'}" />
                                    </TextBlock>

                                    <!-- Description and Client -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding Client}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   Visibility="{Binding Client, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State -->
                <TextBlock Grid.Row="2"
                           Text="No entries for this date"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,12"
                           Visibility="{Binding TasksForDate.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
