<UserControl x:Class="FlexiTrack.Desktop.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:FlexiTrack.Desktop.Infrastructure">

    <UserControl.Resources>
        <infra:StringMatchConverter x:Key="StringMatchConverter" />
        <infra:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Export Tasks"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,16" />

        <!-- Client Filter -->
        <TextBlock Text="Filter by Client"
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,0,6" />

        <ComboBox x:Name="ClientCombo"
                  SelectedValue="{Binding SelectedClient}"
                  Margin="0,0,0,16">
            <ComboBoxItem Content="All Clients" IsSelected="True" Tag="all" />
        </ComboBox>

        <!-- Period Export Section -->
        <Border Background="{StaticResource SurfaceBrush}"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Export by Period"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,12" />

                <!-- Period Selection -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton Content="This Month"
                                 IsChecked="{Binding SelectedPeriod, Converter={StaticResource StringMatchConverter}, ConverterParameter=month}"
                                 Style="{StaticResource FilterButtonStyle}"
                                 Margin="0,0,8,0" />
                    <RadioButton Content="Last Month"
                                 IsChecked="{Binding SelectedPeriod, Converter={StaticResource StringMatchConverter}, ConverterParameter=lastmonth}"
                                 Style="{StaticResource FilterButtonStyle}" />
                </StackPanel>

                <Button Content="Export CSV"
                        Command="{Binding ExportPeriodCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <!-- Export All Section -->
        <Border Background="{StaticResource SurfaceBrush}"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Export All Data"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />

                <TextBlock Text="Creates a ZIP file with monthly CSV files"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,12" />

                <Button Content="Export ZIP"
                        Command="{Binding ExportAllCommand}"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <!-- Status Message -->
        <TextBlock Text="{Binding StatusMessage}"
                   FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
